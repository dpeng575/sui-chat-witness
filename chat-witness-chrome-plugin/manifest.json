{
  "manifest_version": 3,
  "name": "chat-witness: AI Conversation Archive",
  "version": "0.1.0",
  "description": "Archive AI conversations permanently on Sui blockchain with encrypted Walrus storage and verifiable witness proof",
  "permissions": ["storage", "identity", "activeTab", "tabs"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://kimi.moonshot.cn/*",
    "https://salt.api.mystenlabs.com/*",
    "https://prover.mystenlabs.com/*"
  ],
  "externally_connectable": {
    "matches": ["http://localhost:5173/*"]
  },
  "action": {
    "default_popup": "index.html",
    "default_width": 360,
    "default_height": 600
  },
  "background": {
    "service_worker": "src/background/index.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://kimi.moonshot.cn/*"
      ],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ]
}
