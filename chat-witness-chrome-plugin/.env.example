# Supabase 配置
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Google OAuth 配置
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Signer 页面配置
# Local development: http://localhost:3000/en/signer
# Production packaging: set this to your deployed landing signer URL and add the same origin to manifest.json externally_connectable.matches.
VITE_SIGNER_URL=http://localhost:3000/en/signer
