# Supabase 配置
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Google OAuth 配置
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Seal 测试网配置
# VITE_SEAL_PACKAGE_ID 用于 create_witness；VITE_SEAL_NAMESPACE_PACKAGE_ID 用于 Seal encrypt/session/seal_approve。
# VITE_SEAL_NAMESPACE_PACKAGE_ID 必须指向包含 seal_approve 的 version 1 package。
VITE_SEAL_PACKAGE_ID=your-current-published-witness-package-id
VITE_SEAL_NAMESPACE_PACKAGE_ID=your-seal-namespace-package-id
VITE_SEAL_KEY_SERVERS=0x73d05d62c18d9374e3ea529e8e0ed6161da1a141a94d3f76ae3fe4e99356db75,0xf5d14a81a982144ae441cd7d64b09027f116a468bd36e7eca494f750591623c8
VITE_SEAL_THRESHOLD=1

# Walrus 读取配置：建议配置自有或可信 aggregator，避免浏览器直连大量 storage node sliver 请求
VITE_WALRUS_AGGREGATOR_URL=
# 仅调试用：未配置 aggregator 时允许 SDK 直连 storage nodes，可能产生大量 ERR_CONNECTION_CLOSED
VITE_WALRUS_ALLOW_STORAGE_NODE_READS=false
